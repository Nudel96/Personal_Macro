{
    admin off
    email {$ACME_EMAIL}
    servers {
        protocols h1 h2
    }
}

{$MACRO_API_HOST} {
    header {
        Cache-Control "private, no-store"
        X-Content-Type-Options nosniff
        X-Robots-Tag "noindex, nofollow, noarchive"
        -Server
    }
    request_body {
        max_size 2097152
    }
    # Preserve path, method and body: the backend authenticates all three.
    reverse_proxy 127.0.0.1:8080
}
