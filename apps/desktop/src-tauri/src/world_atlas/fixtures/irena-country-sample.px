MATRIX="C-ELECCAP";
COPYRIGHT=NO;
SUBJECT-CODE="C-ELECCAP";
SUBJECT-AREA="C-ELECCAP";
TITLE="Electricity capacity statistics by Country/area, Technology, Grid connection and Year";
CONTENTS="Electricity capacity statistics";
STUB="Country/area","Technology","Grid connection","Year";
VALUES("Country/area")="Germany","Nigeria";
VALUES("Technology")="Total renewable energy","Solar energy","Solar photovoltaic","Solar thermal energy","Wind energy","Onshore wind energy","Offshore wind energy","Renewable hydropower","Mixed hydropower","Marine energy","Bioenergy","Solid biofuels","Liquid biofuels",
"Gas biofuels","Renewable waste","Geothermal energy","Total non-renewable energy","Fossil fuels","Coal","Oil","Natural gas","Nuclear energy","Non-renewable waste","Other non-renewable energy","Other non-renewable energy n.e.s.","Pumped hydro";
VALUES("Grid connection")="OnGrid","OffGrid";
VALUES("Year")="2000","2001","2002","2003","2004","2005","2006","2007","2008","2009","2010","2011","2012","2013","2014","2015","2016","2017","2018","2019","2020","2021","2022","2023","2024","2025";
CODES("Country/area")="DEU","NGA";
LAST-UPDATED="20260416 08:00";
UNITS="MW";
DATABASE="IRENA Renewable Energy Statistics database";
SOURCE="IRENA (2026), Renewable Capacity Statistics 2026, International Renewable Energy Agency (IRENA), Abu Dhabi";
NOTE="The power capacity data shown in these tables represents the maximum net generating capacity of power plants and other installations used to produce electricity. For most countries and technologies, the data reflects the capacity installed and connected "
"at the end of the calendar year. Electricity generation (GWh) is the gross electricity produced by electricity plants, combined heat and power plants (CHP) and distributed generators measured at the output terminals of generation. It includes on-grid and"
" off-grid generation, and it also includes the electricity self-consumed in energy industries; not only the electricity fed into the grid (net electricity production). 2024 electricity generation is preliminary and not accurate at aggregate levels.";
