# Deny everything first. Directory exceptions are immediately narrowed again;
# only the final file patterns supply build input. Paths are apps/desktop-relative.
**
!src-tauri/
src-tauri/**
!src-tauri/src/
src-tauri/src/**
!src-tauri/src/bin/
src-tauri/src/bin/**
!src-tauri/src/commands/
src-tauri/src/commands/**
!src-tauri/src/commands/myfxbook/
src-tauri/src/commands/myfxbook/**
!src-tauri/src/database/
src-tauri/src/database/**
!src-tauri/src/domain/
src-tauri/src/domain/**
!src-tauri/src/government_bonds/
src-tauri/src/government_bonds/**
!src-tauri/src/metrics/
src-tauri/src/metrics/**
!src-tauri/src/repositories/
src-tauri/src/repositories/**
!src-tauri/src/web_server/
src-tauri/src/web_server/**
!src-tauri/src/world_atlas/
src-tauri/src/world_atlas/**
!src-tauri/migrations/
src-tauri/migrations/**
!src-tauri/atlas-migrations/
src-tauri/atlas-migrations/**
!src-tauri/bond-migrations/
src-tauri/bond-migrations/**
!src-tauri/connectors/
src-tauri/connectors/**
!src/
src/**
!src/features/
src/features/**
!src/features/world-atlas/
src/features/world-atlas/**
!src/features/world-atlas/data/
src/features/world-atlas/data/**
!src/features/government-bonds/
src/features/government-bonds/**
!src/features/government-bonds/data/
src/features/government-bonds/data/**

!src-tauri/Cargo.toml
!src-tauri/Cargo.lock
!src-tauri/build.rs
!src-tauri/src/**/*.rs
!src-tauri/migrations/*.sql
!src-tauri/atlas-migrations/*.sql
!src-tauri/bond-migrations/*.sql
!src-tauri/connectors/mt5_account_connector.py
!src/features/world-atlas/data/*.json
!src/features/government-bonds/data/*.json

# Defense in depth, including files accidentally placed inside source folders.
**/.env
**/.env.*
**/*.local
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.zip
**/node_modules
**/target
**/dist
**/dist-private-web
**/.vercel
**/.git
**/backups
**/exports
**/imports
**/.tmp
