# Context: apps/desktop. Vercel builds this image remotely; no personal data.
FROM rust:1.97-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake clang pkg-config libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build/apps/desktop/src-tauri
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/build.rs ./
COPY src-tauri/src ./src
COPY src-tauri/examples/import_private_snapshot.rs ./examples/import_private_snapshot.rs
COPY src-tauri/examples/finish_private_snapshot.rs ./examples/finish_private_snapshot.rs
COPY src-tauri/examples/publish_public_snapshot.rs ./examples/publish_public_snapshot.rs
COPY src-tauri/examples/atlas_public_qa.rs ./examples/atlas_public_qa.rs
COPY src-tauri/migrations ./migrations
COPY src-tauri/postgres-migrations ./postgres-migrations
COPY src-tauri/atlas-migrations ./atlas-migrations
COPY src-tauri/bond-migrations ./bond-migrations
COPY src-tauri/connectors/mt5_account_connector.py ./connectors/mt5_account_connector.py
COPY src-tauri/connectors/mt5_market_connector.py ./connectors/mt5_market_connector.py
COPY src/features/world-atlas/data ../src/features/world-atlas/data
COPY src/features/government-bonds/data ../src/features/government-bonds/data
COPY src/features/weather/data ../src/features/weather/data
RUN cargo build --locked --release --no-default-features --features postgres --bin personal-macro-cloud \
    && strip target/release/personal-macro-cloud

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 macrotool \
    && useradd --uid 10001 --gid 10001 --no-log-init --home-dir /nonexistent --shell /usr/sbin/nologin macrotool
COPY --from=build /build/apps/desktop/src-tauri/target/release/personal-macro-cloud /usr/local/bin/personal-macro-cloud
WORKDIR /tmp
ENV MACRO_BIND_HOST=0.0.0.0
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/personal-macro-cloud"]
