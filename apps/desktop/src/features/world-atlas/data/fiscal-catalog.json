  "metrics": [
    {
      "id": "revenue",
      "field": "rev",
      "label": "Staatseinnahmen",
      "group": "budget",
      "scopeField": "GG_budg",
      "unit": "% des BIP",
      "explanation": "Steuern und andere Einnahmen des erfassten Staates. Der Anteil zeigt seine finanzielle Größe, keine Qualität der Politik."
    },
    {
      "id": "expenditure",
      "field": "exp",
      "label": "Staatsausgaben",
      "group": "budget",
      "scopeField": "GG_budg",
      "unit": "% des BIP",
      "explanation": "Ausgaben einschließlich Zinszahlungen. Hohe Anteile können auch durch ein kleines oder eingebrochenes BIP entstehen."
    },
    {
      "id": "primaryExpenditure",
      "field": "prim_exp",
      "label": "Ausgaben ohne Zinsen",
      "group": "budget",
      "scopeField": "GG_budg",
      "unit": "% des BIP",
      "explanation": "Veröffentlichte Primärausgaben: die Ausgaben des erfassten Staates ohne seine Zinszahlungen."
    },
    {
      "id": "primaryBalance",
      "field": "pb",
      "label": "Primärer Haushaltssaldo",
      "group": "budget",
      "scopeField": "GG_budg",
      "unit": "% des BIP",
      "explanation": "Einnahmen abzüglich Ausgaben ohne Zinsen. Oberhalb null liegt ein Primärüberschuss, darunter ein Primärdefizit. Zinseinnahmen sind hier anders als in manchen IMF-Reihen behandelt."
    },
    {
      "id": "grossDebt",
      "field": "d",
      "label": "Öffentliche Bruttoschulden",
      "group": "debt",
      "scopeField": "GG_debt",
      "unit": "% des BIP",
      "explanation": "Bruttoschulden des erfassten Staates im Verhältnis zur Wirtschaftsleistung. Staatliche Vermögenswerte sind nicht abgezogen; dies ist keine Tragfähigkeits- oder Anlagebewertung."
    },
    {
      "id": "interestExpense",
      "field": "ie",
      "label": "Zinsausgaben des Staates",
      "group": "debt",
      "scopeField": "GG_budg",
      "unit": "% des BIP",
      "explanation": "Gezahlte Zinsen im Verhältnis zum BIP. Tilgungen sind nicht enthalten; dies ist weder der vollständige Schuldendienst noch ein Marktzins."
    },
    {
      "id": "realLongRate",
      "field": "rltir",
      "label": "Langfristiger Realzins",
      "group": "economy",
      "scopeField": "",
      "unit": "%",
      "explanation": "Von der Quelle veröffentlichter langfristiger Zins nach Inflationsbereinigung. Historische Schätzungen und wechselnde Ausgangsquellen bleiben Teil der Reihe."
    },
    {
      "id": "realGrowth",
      "field": "rgc",
      "label": "Reales Wirtschaftswachstum",
      "group": "economy",
      "scopeField": "",
      "unit": "% pro Jahr",
      "explanation": "Veröffentlichte Veränderung der inflationsbereinigten Wirtschaftsleistung. Diese historische Rekonstruktion liefert Kontext und keine Prognose."
    }
  ],
  "breaks": [
