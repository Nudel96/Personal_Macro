# Personal_Macro example configuration — never place real keys in this file.

PERSONAL_MACRO_TIMEZONE=Europe/Berlin
PERSONAL_MACRO_LOG_LEVEL=INFO

# EODHD Economic Events API. Required for Fundamentals and Rates; keep the real
# token only in .env.local or the local machine environment.
EODHD_API_KEY=

# Optional German summaries for public central-bank reports. The report
# collector works without this key and then produces a local extractive
# fallback. No journal, account, trade, or media data is sent to this service.
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-5-mini
# Optional: auf false setzen, um ausschließlich lokale Extrakt-Zusammenfassungen zu verwenden.
OPENAI_REPORT_SUMMARIES_ENABLED=true

# Optional read-only cTrader Open API connection. Register a personal app in
# the official cTrader Open API portal and keep the real secret in .env.local.
# The redirect URI must exactly match one of the approved app redirect URIs.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
