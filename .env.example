# Personal_Macro example configuration — never place real keys in this file.

# Local paths
PERSONAL_MACRO_DATABASE_URL=sqlite:///./data/personal_macro.db
PERSONAL_MACRO_DATA_DIR=./data
PERSONAL_MACRO_TIMEZONE=Europe/Berlin
PERSONAL_MACRO_LOG_LEVEL=INFO

# Optional free official API keys. Leave blank to disable the adapter.
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
STATS_NZ_API_KEY=
ESTAT_JAPAN_APP_ID=

# Optional third-party adapter; the core must work without it.
ALPHA_VANTAGE_API_KEY=

# Optional forecast/consensus adapter. The current product slice runs in
# manual mode without a provider key; never add real credentials to this file.
PERSONAL_MACRO_FORECAST_PROVIDER=manual
TRADING_ECONOMICS_API_KEY=
PERSONAL_MACRO_JOURNAL_DB=
