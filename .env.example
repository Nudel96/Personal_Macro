# Personal_Macro example configuration — never place real keys in this file.

PERSONAL_MACRO_TIMEZONE=Europe/Berlin
PERSONAL_MACRO_LOG_LEVEL=INFO

# EODHD Economic Events API. Required for Fundamentals and Rates; keep the real
# token only in .env.local or the local machine environment.
EODHD_API_KEY=

# Optional German summaries for public central-bank reports. The report
# collector works without this key and then produces a local extractive
# fallback. No journal, account, trade, or media data is sent to this service.
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-5-mini
# Optional: auf false setzen, um ausschließlich lokale Extrakt-Zusammenfassungen zu verwenden.
OPENAI_REPORT_SUMMARIES_ENABLED=true

# Optional read-only cTrader Open API connection. Register a personal app in
# the official cTrader Open API portal and keep the real secret in .env.local.
# The redirect URI must exactly match one of the approved app redirect URIs.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=

# Optional, local deployment preflight only; never expose as VITE_* or upload.
# Supply through the process environment when checking the private Vercel project.
VERCEL_TOKEN=

# Private Vercel production only: random 32+ character bearer for the native
# daily COT planner. Keep server-side; never prefix with VITE_ or place in URLs.
# Cron plans a Frankfurt Queue job for the CFTC release + 60 minutes.
CRON_SECRET=
# Opt in on the private production deployment only; leave empty in previews.
MACRO_COT_AUTOMATION=

# Private cloud provider jobs; empty means disabled. Keep off in previews.
# EODHD_API_KEY must also be configured on the server for economic releases.
MACRO_ECONOMIC_AUTOMATION=
MACRO_MYFXBOOK_AUTOMATION=
# Independent 32-byte random wrapping key encoded as base64; server secret only.
# Never rotate without first re-encrypting existing Myfxbook credentials.
MACRO_PROVIDER_KEY=

# Private cloud central-bank discovery and German briefings. Empty disables jobs.
# Set OPENAI_API_KEY only as a server secret; no VITE_ variables. Each upgraded
# desktop/cloud store has an independent fixed $0.50 UTC-month OpenAI sub-budget.
MACRO_REPORT_AUTOMATION=
