# Personal_Macro example configuration — never place real keys in this file.

PERSONAL_MACRO_TIMEZONE=Europe/Berlin
PERSONAL_MACRO_LOG_LEVEL=INFO

# EODHD Economic Events API. Required for Fundamentals and Rates; keep the real
# token only in .env.local or the local machine environment.
EODHD_API_KEY=

# Optional local BlackBull MetaTrader 5 terminal. Leave blank to let MT5 find
# the installed terminal automatically. Never add account credentials here.
BLACKBULL_MT5_TERMINAL_PATH=
BLACKBULL_MT5_SERVER=
